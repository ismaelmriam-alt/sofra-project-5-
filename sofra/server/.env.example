# Copy this file to .env and adjust.
PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/sofra
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sofra?retryWrites=true&w=majority

# Allowed browser origin for the Vite dev server
CLIENT_ORIGIN=http://localhost:5173

# Password for the /admin dashboard (sent as the x-admin-key header). Change it!
ADMIN_PASSWORD=sofra2026

# OPTIONAL: Cloudinary for admin photo uploads on hosting without a writable disk (e.g. Vercel).
# Leave these out and the server still starts; only uploading a NEW photo shows a friendly message.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
